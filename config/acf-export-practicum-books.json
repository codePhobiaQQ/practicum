[
  {
    "key": "group_practicum_book_01",
    "title": "Пособие (book)",
    "fields": [
      {
        "key": "field_pb_preview",
        "label": "Превью",
        "name": "preview",
        "type": "image",
        "instructions": "Картинка для карточки и шапки (если нет обложки записи)",
        "required": 0,
        "return_format": "url",
        "preview_size": "large",
        "library": "all"
      },
      {
        "key": "field_pb_book_name",
        "label": "Название",
        "name": "book_name",
        "type": "text",
        "instructions": "Отображаемое название (если пусто — заголовок записи)",
        "required": 0
      },
      {
        "key": "field_pb_description",
        "label": "Описание",
        "name": "description",
        "type": "wysiwyg",
        "instructions": "Полное описание пособия",
        "required": 0,
        "tabs": "all",
        "toolbar": "full",
        "media_upload": 1
      },
      {
        "key": "field_pb_book_category",
        "label": "Категория",
        "name": "book_category",
        "type": "taxonomy",
        "instructions": "Рубрика пособия",
        "required": 0,
        "taxonomy": "book_category",
        "field_type": "select",
        "allow_null": 1,
        "add_term": 1,
        "save_terms": 1,
        "load_terms": 1,
        "return_format": "object",
        "multiple": 0
      },
      {
        "key": "field_pb_duration",
        "label": "Длительность",
        "name": "duration",
        "type": "text",
        "instructions": "Например: 10 месяцев",
        "required": 0
      },
      {
        "key": "field_pb_teaser",
        "label": "Краткий анонс",
        "name": "teaser",
        "type": "textarea",
        "instructions": "Для карточки в списке",
        "required": 0,
        "rows": 4,
        "new_lines": "br"
      },
      {
        "key": "field_pb_materials_outer",
        "label": "Материалы (программа)",
        "name": "materials",
        "type": "repeater",
        "instructions": "Структура: модуль → уроки → блоки материалов",
        "required": 0,
        "layout": "block",
        "button_label": "Добавить модуль",
        "sub_fields": [
          {
            "key": "field_pb_module_title",
            "label": "Название модуля",
            "name": "module_title",
            "type": "text",
            "required": 1
          },
          {
            "key": "field_pb_lessons",
            "label": "Уроки",
            "name": "lessons",
            "type": "repeater",
            "layout": "block",
            "button_label": "Добавить урок",
            "sub_fields": [
              {
                "key": "field_pb_lesson_title",
                "label": "Название урока",
                "name": "lesson_title",
                "type": "text",
                "required": 1
              },
              {
                "key": "field_pb_lesson_slug",
                "label": "Слаг урока (опционально)",
                "name": "lesson_slug",
                "type": "text",
                "required": 0
              },
              {
                "key": "field_pb_lesson_blocks",
                "label": "Блоки урока",
                "name": "lesson_blocks",
                "type": "repeater",
                "layout": "block",
                "button_label": "Добавить блок",
                "sub_fields": [
                  {
                    "key": "field_pb_material_block_type",
                    "label": "Тип блока",
                    "name": "block_type",
                    "type": "select",
                    "required": 1,
                    "choices": {
                      "text": "Текст",
                      "video": "Видео",
                      "file": "Файл",
                      "quiz_ref": "Квиз (внешний ID)"
                    },
                    "default_value": "text",
                    "return_format": "value",
                    "multiple": 0,
                    "allow_null": 0,
                    "ui": 1
                  },
                  {
                    "key": "field_pb_material_text",
                    "label": "Текст",
                    "name": "text_content",
                    "type": "wysiwyg",
                    "required": 0,
                    "conditional_logic": [
                      [
                        {
                          "field": "field_pb_material_block_type",
                          "operator": "==",
                          "value": "text"
                        }
                      ]
                    ],
                    "tabs": "all",
                    "toolbar": "full",
                    "media_upload": 1
                  },
                  {
                    "key": "field_pb_material_video_url",
                    "label": "URL видео",
                    "name": "video_url",
                    "type": "url",
                    "required": 0,
                    "conditional_logic": [
                      [
                        {
                          "field": "field_pb_material_block_type",
                          "operator": "==",
                          "value": "video"
                        }
                      ]
                    ]
                  },
                  {
                    "key": "field_pb_material_file",
                    "label": "Файл",
                    "name": "file",
                    "type": "file",
                    "required": 0,
                    "conditional_logic": [
                      [
                        {
                          "field": "field_pb_material_block_type",
                          "operator": "==",
                          "value": "file"
                        }
                      ]
                    ],
                    "return_format": "url",
                    "library": "all"
                  },
                  {
                    "key": "field_pb_material_quiz_ref",
                    "label": "ID / ключ квиза",
                    "name": "quiz_ref",
                    "type": "text",
                    "required": 0,
                    "conditional_logic": [
                      [
                        {
                          "field": "field_pb_material_block_type",
                          "operator": "==",
                          "value": "quiz_ref"
                        }
                      ]
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "key": "field_pb_attachments",
        "label": "Вложения",
        "name": "attachments",
        "type": "gallery",
        "instructions": "Галерея файлов и изображений",
        "required": 0,
        "return_format": "array",
        "preview_size": "medium",
        "insert": "append",
        "library": "all"
      }
    ],
    "location": [
      [
        {
          "param": "post_type",
          "operator": "==",
          "value": "book"
        }
      ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "hide_on_screen": "",
    "active": true,
    "description": "Поля для CPT book. Аналогично структуре courses.",
